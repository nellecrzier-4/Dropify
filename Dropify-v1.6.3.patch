diff --git a/lib/controllers/gofile_controller.dart b/lib/controllers/gofile_controller.dart
index 80ec1b8..aed716c 100644
--- a/lib/controllers/gofile_controller.dart
+++ b/lib/controllers/gofile_controller.dart
@@ -112,7 +112,7 @@ class GofileController extends ChangeNotifier {
     if (account == null) return;
     try {
       _entries = await api.list(account.rootFolder, account.token);
-      _error = null;
+      _error = _entries.isEmpty ? 'kosong' : null;
     } catch (e) {
       _error = e is GofileException ? e.code : 'koneksi';
     }
@@ -154,6 +154,9 @@ class GofileController extends ChangeNotifier {
 
   String? get shareId => _shareId;
 
+  /// Diagnosa panggilan terakhir (untuk layar Gofile).
+  String get diagnostics => api.lastDebug;
+
   Future<void> logout() async {
     _token = null;
     _account = null;
diff --git a/lib/screens/files_tab.dart b/lib/screens/files_tab.dart
index b6c988f..c1a8d6e 100644
--- a/lib/screens/files_tab.dart
+++ b/lib/screens/files_tab.dart
@@ -282,11 +282,21 @@ class _GofileBrowserState extends State<_GofileBrowser> {
                       const SizedBox(height: 10),
                       Text(
                         s.gofileEmpty,
+                        textAlign: TextAlign.center,
                         style: TextStyle(
                           color: scheme.onSurfaceVariant,
                           fontSize: 13,
                         ),
                       ),
